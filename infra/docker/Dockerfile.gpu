# Ray image for the GPU cluster: the stock CPU image plus a C compiler.
# Triton (used by recent PyTorch GPU kernels and torch.compile) compiles a small
# C launcher on first use and fails with "Failed to find C compiler" without one.
# CUDA itself comes from the PyTorch wheels installed per job (runtime-envs/gpu*.yaml).
#
# Built and loaded into kind by infra/scripts/deploy.sh when GPU=1:
#   docker build -f infra/docker/Dockerfile.gpu -t ray-gpu:2.58.0-py312 infra/docker
#   kind load docker-image ray-gpu:2.58.0-py312 --name ray
FROM rayproject/ray:2.58.0-py312

RUN sudo apt-get update \
 && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gcc libc6-dev \
 && sudo rm -rf /var/lib/apt/lists/*
